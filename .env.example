# Copy to .env and fill in. Never commit the filled file.

# From your WebUntis login URL: https://<UNTIS_SERVER>/WebUntis/?school=<UNTIS_SCHOOL>
UNTIS_SERVER=example.webuntis.com
UNTIS_SCHOOL=example-school
UNTIS_USERNAME=
UNTIS_PASSWORD=
UNTIS_CLASS=

# Only needed once you run the full sync (python sync.py), not for --raw/--dry-run.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
